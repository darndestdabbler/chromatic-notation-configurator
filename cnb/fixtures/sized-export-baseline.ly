          '((shape      . crotchet-minim-h2p724-w4)
            (color      . black-000000)
            (hollow     . #f)
            (attachment . crotchet-minim-h2p724-w4-attach)
            (off-key-mark . #f)
            (repeat     . #f)))

         ;; C♯, D♯, F♯, G♯, A♯ → crotchet-minim-h1p5-w3, hollow, black-000000
         ((memv pc '(1 3 6 8 10))
          '((shape      . crotchet-minim-h1p5-w3)
            (color      . black-000000)
            (hollow     . crotchet-minim-h1p5-w3-cutout)
            (attachment . crotchet-minim-h1p5-w3-attach)
            (off-key-mark . #f)
            (repeat     . #f)))

         ;; D, E, F, G, A, B → crotchet-minim, solid, black-000000
         ((memv pc '(2 4 5 7 9 11))
          '((shape      . crotchet-minim)
            (color      . black-000000)
            (hollow     . #f)
            (attachment . crotchet-minim-attach)
            (off-key-mark . #f)
            (repeat     . #f)))

         ;; Fallback
