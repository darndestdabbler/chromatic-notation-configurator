  { "field": "engine.defaultMagnify", "path": ["engine", "defaultMagnify"], "expect": "rejected",
    "value": "7/4) #(display \"INJECTED-MAGNIFY\") (+ 1", "marker": "INJECTED-MAGNIFY" },
  { "field": "engine.indent", "path": ["engine", "indent"], "expect": "rejected",
    "value": "0) #(display \"INJECTED-INDENT\") (+ 0", "marker": "INJECTED-INDENT" },
  { "field": "shapes.lilypondPath", "path": ["shapes", "crotchet-minim", "lilypondPath"], "expect": "rejected",
    "value": "'((moveto 0 1) (closepath)) #(display \"INJECTED-PATH\") (define cnb:x '()", "marker": "INJECTED-PATH" },
  { "field": "shapes.lilypondHollowPath", "path": ["shapes", "crotchet-minim", "lilypondHollowPath"], "expect": "rejected",
    "value": "'()) (system \"echo INJECTED-HOLLOW\") (define cnb:y '()", "marker": "INJECTED-HOLLOW" }
