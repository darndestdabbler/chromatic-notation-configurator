  { "field": "meta.notationFootnote", "path": ["meta", "notationFootnote"], "expect": "exported",
    "value": "x\") #(display \"INJECTED-FOOTNOTE\") (string-append \"", "marker": "INJECTED-FOOTNOTE" },
  { "field": "meta.fileSuffix", "path": ["meta", "fileSuffix"], "expect": "exported",
    "value": "-x\\\") #(display \"INJECTED-FILE-SUFFIX\") (string-append \"", "marker": "INJECTED-FILE-SUFFIX" },
  { "field": "durations.definitions[0].name", "path": ["durations", "definitions", 0, "name"], "expect": "exported",
    "value": "crotchet\n#(display \"INJECTED-DURATION-NAME\")\n;;", "marker": "INJECTED-DURATION-NAME" },
  { "field": "shape name", "renameShape": "crotchet-minim", "expect": "exported",
