%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%     SECTION C — CONFIGURATION PROCEDURE
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%
%% The procedure below maps (semitone, duration, key) to a config alist.
%% Generated from the notehead rules, resolved per pitch class
%% (priority-ordered cumulative merge via CNBConfig.resolveNotehead).
%%

#(set! cnb:get-notehead-config
   (lambda (semitone duration key)
     (let ((pc (modulo semitone 12)))
       (cond
         ;; C, D, E, F, G, A, B (crotchet) → diamond, solid, black-000000
         ((and (memv pc '(0 2 4 5 7 9 11)) (= duration 3))
          '((shape      . diamond)
            (color      . black-000000)
            (hollow     . #f)
            (attachment . diamond-attach)
