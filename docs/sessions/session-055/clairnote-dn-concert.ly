%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%     SECTION C — CONFIGURATION PROCEDURE
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%
%% The procedure below maps (semitone, duration, key) to a config alist.
%% Generated from the notehead rules, resolved per pitch class
%% (priority-ordered cumulative merge via CNBConfig.resolveNotehead).
%%

#(set! cnb:get-notehead-config
   (lambda (semitone duration key)
     (let ((pc (modulo semitone 12)))
       (cond
         ;; C, D, E, F♯, G♯, A♯ → crotchet-minim, solid, black-000000
         ((memv pc '(0 2 4 6 8 10))
          '((shape      . crotchet-minim)
            (color      . black-000000)
            (hollow     . #f)
            (attachment . crotchet-minim-attach)
            (off-key-mark . #f)
            (repeat     . #f)))

         ;; C♯, D♯, F, G, A, B → crotchet-minim, hollow, black-000000
         ((memv pc '(1 3 5 7 9 11))
          '((shape      . crotchet-minim)
            (color      . black-000000)
            (hollow     . crotchet-minim-cutout)
            (attachment . crotchet-minim-attach)
            (off-key-mark . #f)
            (repeat     . #f)))

         ;; Fallback
         (else
          '((shape      . crotchet-minim)
            (color      . black-000000)
            (hollow     . #f)
            (attachment . crotchet-minim-attach)
            (off-key-mark . #f)
            (repeat     . #f)))))))

